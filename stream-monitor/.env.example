# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# .env is git-ignored. Never commit it or share it.
# A platform whose credentials are left empty shows its streamers as UNKNOWN.

# --- Twitch (Helix API) -------------------------------------------------------
# 1. Log in at https://dev.twitch.tv/console/apps and click "Register Your Application".
# 2. OAuth Redirect URL: http://localhost (unused, but required by the form).
#    Client Type: Confidential.
# 3. Copy the Client ID, then click "New Secret" for the Client Secret.
# The script gets an app access token itself (client-credentials flow).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Kick (Kick Public API) ---------------------------------------------------
# 1. Log in to kick.com, open Settings -> Developer and create an app.
#    (Two-factor authentication must be enabled on the account.)
# 2. Redirect URL: http://localhost (unused, but required by the form).
# 3. Copy the Client ID and Client Secret.
# The script gets an app access token itself (client-credentials flow).
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# --- YouTube (YouTube Data API v3) --------------------------------------------
# 1. In https://console.cloud.google.com create (or pick) a project.
# 2. APIs & Services -> Library -> enable "YouTube Data API v3".
# 3. APIs & Services -> Credentials -> Create credentials -> API key.
#    Recommended: restrict the key to "YouTube Data API v3".
# Default quota: 10,000 units/day per project (see README for usage).
YOUTUBE_API_KEY=

# --- TikTok LIVE --------------------------------------------------------------
# No credentials: TikTok offers no official API for checking whether an account
# is live, so TikTok streamers are always shown as UNKNOWN. See README.
