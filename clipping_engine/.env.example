# Clipping engine credentials. Copy to clipping_engine/.env and fill in:
#     cp clipping_engine/.env.example clipping_engine/.env
# .env is git-ignored. Never commit it.
#
# Platform keys for live detection stay in stream-monitor/.env
# (TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET, KICK_CLIENT_ID / KICK_CLIENT_SECRET,
# YOUTUBE_API_KEY). The engine reads that file too and reuses them for chat.

# --- Discord (where finished clips are sent) -------------------------------------
# Discord server -> Server Settings -> Integrations -> Webhooks -> New Webhook ->
# choose the channel -> Copy Webhook URL. Treat it like a password.
DISCORD_WEBHOOK_URL=

# --- Claude (AI entertainment evaluation, optional) ----------------------------------
# https://console.anthropic.com -> API Keys. Without it, clips are scored from
# audio, chat and speech signals only.
ANTHROPIC_API_KEY=

# --- Twitch chat (optional overrides) ---------------------------------------------------
# Chat uses the monitor's Twitch app (TWITCH_CLIENT_ID) and a one-time login:
#     python -m clipping_engine auth twitch
# If Twitch rejects the device login for that app, register a second app with
# Client Type "Public" and put its ID here (no secret needed for public apps).
TWITCH_CHAT_CLIENT_ID=
TWITCH_CHAT_CLIENT_SECRET=
